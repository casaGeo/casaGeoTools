msgid "course"
msgstr ""

#: ../../casageo.logistics.rst:-1
msgid "int"
msgstr ""

#: ../../casageo.logistics.rst:60 ../../casageo.logistics.rst:128
msgid ""
"The direction (degrees in clockwise direction, 0 is north) from which "
"this waypoint should be approached or in which it should be left."
msgstr ""

#: ../../casageo.logistics.rst:63
msgid "radius"
msgstr ""

#: ../../casageo.logistics.rst:64
msgid ""
"Consider all places within this radius, in meters, as potential "
"candidates for matching the waypoint. If ``snap`` is enabled, match the "
"waypoint to the most significant road within this radius."
msgstr ""

#: ../../casageo.logistics.rst:68
msgid "snap"
msgstr ""

#: ../../casageo.logistics.rst:-1
msgid "bool"
msgstr ""

#: ../../casageo.logistics.rst:69
msgid ""
"Controls the meaning of the ``radius`` parameter, the default is "
"``False``."
msgstr ""

