msgid "str"
msgstr ""

#: ../../casageo.logistics.rst:38
msgid ""
"Either ``\"origin\"`` or ``\"destination\"``, the default is "
"``\"origin\"``. If no destination waypoints are specified, routes are "
"calculated between all origin waypoints."
msgstr ""

#: ../../casageo.logistics.rst:42 ../../casageo.logistics.rst:114
